#!/bin/sh
# Обёртка Gradle. Бинарный gradle-wrapper.jar в репозиторий не кладём (чужой бинарник).
# Его создаёт один раз сам Gradle или Android Studio:
#   gradle wrapper --gradle-version 8.11.1      (или: открыть папку android-app в Android Studio)
DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "Нет gradle/wrapper/gradle-wrapper.jar."
  echo "Создайте его один раз: cd android-app && gradle wrapper --gradle-version 8.11.1"
  echo "или откройте android-app в Android Studio — она сделает это сама."
  exit 1
fi
exec java -Xmx64m -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
