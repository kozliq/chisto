# Копия этого файла -> .env (скрипт scripts/setup.sh сделает сам).
# В .env не кладите ничего, кроме того, что здесь перечислено.

# Имя сервера: на него идут DoH, DoT и сайт с кнопками.
# A-запись этого имени должна смотреть на SERVER_IP.
DOH_HOST=dns.example.com
# Путь DoH. Caddy пробрасывает его на /dns-query AdGuard Home.
DOH_PATH=/dns-query
# Публичный IPv4 сервера (для профиля iOS и инструкций).
SERVER_IP=203.0.113.10

# Почта для Let's Encrypt (уведомления о сертификате).
ACME_EMAIL=admin@example.com
# Папка сертификата внутри данных Caddy. Для боевого сервера не трогать.
# Для локальной проверки с DOH_HOST=localhost поставьте: local
CERT_ISSUER_DIR=acme-v02.api.letsencrypt.org-directory

# Логин панели AdGuard Home. Пароль генерирует setup.sh и пишет в server/.admin-password
ADMIN_USER=admin

# Бренд и идентификаторы (свои, не чужие).
BRAND_NAME=Чисто
PROFILE_ID=com.example.chisto

# Ссылки на опубликованное расширение. Пусто = кнопка ведёт на zip и инструкцию.
CHROME_STORE_URL=
FIREFOX_AMO_URL=
# Ссылка на App Store / TestFlight. Пусто = на сайте только профиль.
IOS_APP_URL=
# Имя Telegram-бота без @ (пусто — на сайте ссылки нет). Токен — только в cloudflare/.tg-token
TG_BOT=
